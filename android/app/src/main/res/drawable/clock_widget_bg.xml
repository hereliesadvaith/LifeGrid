<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing-style card: dark "surface" fill with a hairline border, plus a tiled
  dotted grid. The dot layer is inset so its (square) bounds stay inside the
  rounded corners rather than poking out over the wallpaper.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clock_surface" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/clock_line" />
        </shape>
    </item>
    <item
        android:left="9dp"
        android:top="9dp"
        android:right="9dp"
        android:bottom="9dp"
        android:drawable="@drawable/clock_dot_tile" />
</layer-list>
