<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing-style home-screen clock (4×4).
    · top-left   : "WELCOME" + profile first name (set by ClockWidgetProvider)
    · bottom-left: live time (TextClock, system-driven, no app process)
  The hour follows the device's 12/24-hour setting via the paired formats.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/clock_widget_bg"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="start">

        <!-- Greeting, top-left -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/clock_text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.22"
            android:text="WELCOME" />

        <TextView
            android:id="@+id/clock_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/doto"
            android:textStyle="bold"
            android:textColor="@color/clock_text"
            android:textSize="28sp"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Advaith" />

        <!-- Spacer (a plain View isn't allowed in RemoteViews; an empty
             LinearLayout is) pushes the time to the bottom. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Time, bottom-left -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextClock
                android:id="@+id/clock_hh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/doto"
                android:textStyle="bold"
                android:textColor="@color/clock_text"
                android:textSize="58sp"
                android:letterSpacing="0.03"
                android:includeFontPadding="false"
                android:format12Hour="hh"
                android:format24Hour="HH" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/doto"
                android:textStyle="bold"
                android:textColor="@color/clock_accent"
                android:textSize="58sp"
                android:includeFontPadding="false"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:text=":" />

            <TextClock
                android:id="@+id/clock_mm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/doto"
                android:textStyle="bold"
                android:textColor="@color/clock_text"
                android:textSize="58sp"
                android:letterSpacing="0.03"
                android:includeFontPadding="false"
                android:format12Hour="mm"
                android:format24Hour="mm" />

            <TextClock
                android:id="@+id/clock_ss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:fontFamily="@font/doto"
                android:textColor="@color/clock_text_dim"
                android:textSize="20sp"
                android:paddingLeft="6dp"
                android:paddingBottom="7dp"
                android:includeFontPadding="false"
                android:format12Hour="ss"
                android:format24Hour="ss" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="top|left"
        android:importantForAccessibility="no"
        android:src="@drawable/clock_corner_tl" />

    <ImageView
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="bottom|right"
        android:importantForAccessibility="no"
        android:src="@drawable/clock_corner_br" />
</FrameLayout>
